# A bare `node_modules` only matches the root, so the workspace copies were
# still being shipped into the build context.
node_modules
**/node_modules
# Build output is produced inside the image; copying a local one in risks
# baking a stale bundle.
**/dist
.git
.gitignore
README.md
.env
.env.local
.env.production.local
.env.test.local
.env.development.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.vscode
.idea
.next
*.swp
*.swo
*~

# Exclude Expo app build artifacts and dependencies
examples/expo-app/node_modules
examples/expo-app/.expo
examples/expo-app/dist

# Regenerated inside the image by the editor build
packages/website/public/editor
