{
  "name": "@nayan-ui/root",
  "version": "1.0.0",
  "private": true,
  "description": "Game engine and components for React and React Native.",
  "license": "ISC",
  "workspaces": [
    "packages/nayan-ui",
    "packages/website"
  ],
  "scripts": {
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "lint": "bun lint --no-script .",
    "lint:fix": "bun lint --no-script --fix .",
    "typecheck": "bun run --parallel engine:typecheck website:typecheck",
    "test": "bun run --sequential engine:test engine:test:integration website:test",
    "quality": "bun run --parallel --no-exit-on-error format:check lint typecheck test",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/lib packages/*/dist",
    "website:dev": "bun run --filter @nayan-ui/website dev",
    "website:build": "bun run --filter @nayan-ui/website build",
    "website:start": "bun run --filter @nayan-ui/website start",
    "engine:build": "bun run --filter nayan-ui build",
    "engine:typecheck": "bun run --filter nayan-ui typecheck",
    "engine:test": "bun run --filter nayan-ui test",
    "engine:test:integration": "bun run --filter nayan-ui test:integration",
    "engine:test:web": "bun run --filter nayan-ui test:web",
    "engine:test:coverage": "bun run --filter nayan-ui test:coverage",
    "engine:core:test": "bun run --filter nayan-ui core:test",
    "engine:core:build": "bun run --filter nayan-ui core:build",
    "engine:core:build:ios": "bun run --filter nayan-ui core:build:ios",
    "engine:core:build:android": "bun run --filter nayan-ui core:build:android",
    "engine:core:build:web": "bun run --filter nayan-ui core:build:web",
    "engine:build:web": "bun run --filter nayan-ui build:web",
    "engine:codegen": "bun run --filter nayan-ui codegen",
    "website:typecheck": "bun run --filter @nayan-ui/website typecheck",
    "website:test": "bun run --filter @nayan-ui/website test"
  }
}
