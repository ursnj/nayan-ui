{
  "name": "@nayan-ui/root",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Component Libraries for React and React Native.",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "packages/native/example",
    "applications/*"
  ],
  "scripts": {
    "format": "oxfmt",
    "clean": "rimraf packages/*/node_modules packages/*/dist packages/*/lib node_modules",
    "ai:build": "yarn workspace @nayan-ui/ai build",
    "cli:build": "yarn workspace @nayan-ui/cli build",
    "react:dev": "yarn workspace @nayan-ui/react dev",
    "react:build": "yarn workspace @nayan-ui/react build",
    "native:build": "yarn workspace @nayan-ui/native build",
    "native:typecheck": "yarn workspace @nayan-ui/native typecheck",
    "native:clean": "yarn workspace @nayan-ui/native clean",
    "native:example": "yarn workspace @nayan-ui/native example",
    "website:dev": "yarn react:build && yarn workspace @nayan-ui/website dev",
    "website:build": "yarn react:build && yarn editor:build && yarn workspace @nayan-ui/website build",
    "website:start": "yarn workspace @nayan-ui/website start",
    "editor:dev": "yarn workspace @nayan-ui/video-editor dev",
    "editor:build": "yarn workspace @nayan-ui/video-editor build"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "rimraf": "^6.0.1"
  },
  "packageManager": "yarn@4.11.0"
}
