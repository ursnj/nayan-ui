{
  "name": "nayan-ui",
  "version": "1.0.0-beta.6",
  "description": "Nayan Components, Nayan Modules and Nayan Game Engine for React and React Native. Cross-platform UI, Rust and wgpu rendering, Rapier physics, animation, media and application services.",
  "keywords": [
    "3d",
    "android",
    "drawing",
    "game-engine",
    "ios",
    "metal",
    "nayan-ui",
    "particles",
    "physics",
    "rapier",
    "react",
    "react-game-engine",
    "react-native",
    "react-native-game-engine",
    "rust",
    "vulkan",
    "web",
    "webassembly",
    "webgl",
    "webgpu",
    "wgpu"
  ],
  "homepage": "https://www.nayanui.com",
  "bugs": {
    "url": "https://github.com/ursnj/nayan-ui/issues"
  },
  "license": "MIT",
  "author": "Niranjan Devasani <niranjan.devasani@gmail.com> (https://github.com/ursnj)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ursnj/nayan-ui.git",
    "directory": "packages/nayan-ui"
  },
  "bin": {
    "nayan-ui": "./cli/index.mjs"
  },
  "files": [
    "cli/index.mjs",
    "cli/template.json",
    "src/**/*.{ts,tsx,js}",
    "src/components/icons/LICENSE.lucide",
    "lib/module/**/*.{js,d.ts}",
    "lib/module/package.json",
    "lib/module/components/icons/LICENSE.lucide",
    "lib/typescript/**/*.d.ts",
    "lib/typescript/package.json",
    "lib/web/**/*.{js,d.ts}",
    "lib/web/engine_core_bg.wasm",
    "lib/web/components/icons/{named,paths}/package.json",
    "lib/web/components/icons/paths/LICENSE.lucide",
    "shared/cpp/**/*.{h,cpp}",
    "shared/ios/**/*.{h,m,mm,xcprivacy}",
    "shared/android/{CMakeLists.txt,NayanEngineSpec.h,build.gradle,proguard-rules.pro}",
    "shared/android/codegen/CMakeLists.txt",
    "shared/android/src/main/**/*.{java,xml}",
    "native/*/rust/**/*.{rs,wgsl}",
    "native/image-picker/rust/color-matrices.json",
    "native/*/cpp/**/*.{h,cpp}",
    "native/*/ios/**/*.{h,m,mm}",
    "native/*/android/**/*.{java,xml}",
    "native/drawing/THIRD_PARTY_LICENSES.txt",
    "NayanEngine.podspec",
    "react-native.config.js",
    "app.plugin.js",
    "scripts/expo-plugin.cjs",
    "native/core/.cargo/config.toml",
    "native/core/Cargo.toml",
    "native/core/Cargo.lock",
    "native/core/src/**/*.rs",
    "native/core/scripts/{features,rust-toolchain,profile-ios,build-android,build-web}.sh",
    "native/core/include/engine_core.h",
    "native/core/build/EngineCore.xcframework/Info.plist",
    "native/core/build/EngineCore.xcframework/{ios-arm64,ios-arm64-simulator}/libengine_core.a",
    "native/core/build/android/{arm64-v8a,armeabi-v7a,x86_64,x86}/libengine_core.a",
    "!**/.*",
    "!**/*.map",
    "!**/{__tests__,__mocks__,__fixtures__}/**",
    "!native/*/rust/**/tests.rs",
    "!src/styles/**",
    "!lib/module/styles/**",
    "!lib/typescript/src/styles/**",
    "scripts/features.cjs"
  ],
  "sideEffects": false,
  "main": "./lib/module/index.js",
  "browser": "./lib/web/index.js",
