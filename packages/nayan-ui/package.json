    "@types/react-dom": "^19.3.0",
    "@types/react-reconciler": "^0.33.0",
    "bun-types": "latest",
    "del-cli": "^7.0.0",
    "expo": "^58.0.17",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "lightningcss": "^1.30.1",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^6.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "~6.0.3"
  },
