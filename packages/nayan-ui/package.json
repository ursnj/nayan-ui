  "scripts": {
    "clean": "del-cli lib",
    "build": "bun run build:web && bob build",
    "typecheck": "bun check && bun check -p tsconfig.test.json",
    "core:test": "cargo test --manifest-path native/core/Cargo.toml",
    "core:bench": "cargo run --release --example bench --manifest-path native/core/Cargo.toml",
    "core:build": "native/core/scripts/build-ios.sh && native/core/scripts/build-android.sh",
    "core:build:ios": "native/core/scripts/build-ios.sh",
    "core:build:android": "native/core/scripts/build-android.sh",
    "test": "bun test --isolate src",
    "test:integration": "bun test --isolate native/tests",
    "test:coverage": "bun test --isolate --coverage src native/tests && bun scripts/check-coverage.mjs",
    "codegen": "bun scripts/codegen-cxx.js",
    "lint": "bun lint --no-script .",
    "lint:fix": "bun lint --no-script --fix .",
    "core:build:web": "native/core/scripts/build-web.sh",
    "build:web": "bun run core:build:web && bun scripts/build-web.mjs",
    "test:web": "bun test native/tests/web.test.ts",
    "prepack": "bun scripts/build-cli-template.mjs && bun scripts/check-package.mjs"
  },
  "optionalDependencies": {
    "react-reconciler": "^0.34.0"
  },
