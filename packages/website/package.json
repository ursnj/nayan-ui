{
  "name": "@nayan-ui/website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run engine:prepare && next dev",
    "build": "bun run engine:prepare && bun run sitemap:generate && next build && bun scripts/prune-standalone.ts",
    "start": "next start --port 7100",
    "sitemap:generate": "bun scripts/sync-sitemap.ts",
    "sitemap:check": "bun scripts/sync-sitemap.ts --check",
    "reference:generate": "bun run engine:prepare && bun run --cwd ../nayan-ui bob build --target typescript && bun scripts/sync-component-attributes.ts",
    "reference:check": "bun scripts/sync-component-attributes.ts --check",
    "engine:prepare": "(test -s ../nayan-ui/lib/web/engine_core_bg.wasm && test ../nayan-ui/lib/web/components/index.js -nt ../nayan-ui/src/components/index.ts) || bun run --cwd ../nayan-ui build:web",
    "typecheck": "bun run engine:prepare && bun check",
    "test": "bun test scripts src"
  },
  "dependencies": {
    "nayan-ui": "workspace:*",
    "nayan-games": "file:./scripts/nayan-games.tgz",
    "mediabunny": "^1.66.2",
    "next": "16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.4.4",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
  }
}
