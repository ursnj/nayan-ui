{
  "name": "@nayan-ui/website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run engine:prepare && bun scripts/compile-component-styles.ts --dev",
    "build": "bun run styles && bun run sitemap:generate && next build && bun scripts/prune-standalone.ts",
    "start": "next start --port 7100",
    "sitemap:generate": "bun scripts/sync-sitemap.ts",
    "sitemap:check": "bun scripts/sync-sitemap.ts --check",
    "styles": "bun run engine:prepare && bun scripts/compile-component-styles.ts",
    "engine:prepare": "test ../engine/lib/web/styles/index.js -nt ../engine/src/styles/index.ts || bun run --cwd ../engine build:web",
    "typecheck": "bun run styles && bun check",
    "test": "bun test scripts src"
  },
  "dependencies": {
    "@nayan-ui/engine": "workspace:*",
    "@nayan-ui/games": "file:./scripts/nayan-ui-games.tgz",
    "mediabunny": "^1.66.2",
    "next": "16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.4.4",
    "typescript": "~6.0.3"
  }
}
