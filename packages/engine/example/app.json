{
  "expo": {
    "name": "engine",
    "slug": "engine",
    "version": "0.0.1",
    "orientation": "default",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.nayan.engine",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "dev.nayan.engine",
      "permissions": [
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "./plugins/withAndroidMinSdk",
        26
      ]
    ],
    "scheme": "nayan-engine-example",
    "userInterfaceStyle": "automatic"
  }
}
